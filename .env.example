# AI providers are tried in this order: Gemini, Groq, OpenRouter.
# Configure any subset. With none configured, the planner returns a local starter plan.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq, OpenAI-compatible (https://console.groq.com/keys). Both variables are required.
# Use a model ID from https://console.groq.com/docs/models that supports JSON mode.
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter, OpenAI-compatible (https://openrouter.ai/keys). Both variables are required.
# Free models end in ":free"; see https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
